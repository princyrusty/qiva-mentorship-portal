# Copy to .env for local runs (node --env-file=.env server.js). Never commit real values.

# --- core ---
NODE_ENV=development
PORT=3000
# Public address of the site, used in emails and payment return links. Render sets RENDER_EXTERNAL_URL automatically.
SITE_URL=
# PostgreSQL connection string. Leave empty locally to use the built-in in-memory database (data is lost on restart).
DATABASE_URL=
# One-time code to create the owner account at /admin. Use a long random value.
ADMIN_SETUP_CODE=

# --- payments ---
UPI_ID=9084687772@ptsbi
UPI_PAYEE_NAME=QIVA Mentorship
# Cashfree Payment Gateway. Online payments switch on when both keys are set.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox or production
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01

# --- email (Resend, https://resend.com) ---
RESEND_API_KEY=
# Until you verify your own domain in Resend, keep onboarding@resend.dev (it can only send to your own Resend login email).
EMAIL_FROM=QIVA Mentorship <onboarding@resend.dev>
EMAIL_REPLY_TO=aithemeroom@gmail.com
ADMIN_NOTIFY_EMAIL=aithemeroom@gmail.com

# --- contact details shown on the site ---
WHATSAPP_NUMBER=919997030409
WHATSAPP_DISPLAY=+91 99970 30409
SUPPORT_PHONE=+91 90846 87772
SUPPORT_EMAIL=aithemeroom@gmail.com
SUPPORT_HOURS=Monday to Saturday, 10 AM to 8 PM IST

# --- legal (Consumer Protection (E-Commerce) Rules, 2020) ---
COMPANY_LEGAL_NAME=QIVA Connect Private Limited
COMPANY_ADDRESS=Tower B, Flat 106, Jalvayu Towers, Kahagra, Dehradun, Uttarakhand, India
GSTIN=
CIN=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_DESIGNATION=Grievance Officer
GRIEVANCE_OFFICER_EMAIL=aithemeroom@gmail.com
GRIEVANCE_OFFICER_PHONE=+91 90846 87772
